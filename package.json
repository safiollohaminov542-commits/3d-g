{
  "name": "3d-g",
  "version": "0.1.0",
  "private": true,
  "description": "3D online multiplayer racing game (open-world city, top-down) with React + Three.js + Colyseus",
  "scripts": {
    "dev": "pnpm --parallel --filter=@3dg/server --filter=@3dg/client dev",
    "dev:client": "pnpm --filter=@3dg/client dev",
    "dev:server": "pnpm --filter=@3dg/server dev",
    "build": "pnpm --filter=@3dg/client build && pnpm --filter=@3dg/server build",
    "start": "pnpm --filter=@3dg/server start",
    "start:server": "pnpm --filter=@3dg/server start",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
